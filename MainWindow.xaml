<Window x:Class="CustomHidChecker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:CustomHidChecker.ViewModels"
        mc:Ignorable="d"
        Title="Custom HID Checker" Height="800" Width="1200" MinHeight="500" MinWidth="800">
    <Window.DataContext>
        <viewModels:MainViewModel />
    </Window.DataContext>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0 0 0 12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ComboBox Grid.Column="0"
                      ItemsSource="{Binding Devices}"
                      SelectedItem="{Binding SelectedDevice}"
                      DisplayMemberPath="DisplayName"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Center"
                      MinWidth="240" />

            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8">
                <Button Content="再検索"
                        Command="{Binding RefreshDevicesCommand}"
                        Padding="12 6" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8">
                <Button Content="接続"
                        Command="{Binding ConnectCommand}"
                        Padding="12 6" />
                <Button Content="切断"
                        Command="{Binding DisconnectCommand}"
                        Padding="12 6" />
            </StackPanel>

            <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="8">
                <Button Content="ログ保存"
                        Command="{Binding ExportLogCommand}"
                        Padding="12 6" />
                <Button Content="ログクリア"
                        Command="{Binding ClearLogCommand}"
                        Padding="12 6" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="10*" />
                <RowDefinition Height="10*" />
                <RowDefinition Height="6*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Row="0" Grid.Column="0" Header="接続デバイス情報" Margin="12">
                <TextBlock Text="{Binding ConnectedDeviceDetails}" Margin="12" TextWrapping="Wrap" />
            </GroupBox>

            <GroupBox Grid.Row="1" Grid.Column="0" Header="USBディスクリプタ情報" Margin="12">
                <TabControl Margin="8">
                    <TabItem Header="Device">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBox Text="{Binding DescriptorInfo.DeviceDescriptor, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" BorderThickness="0" Background="Transparent" />
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="Configuration">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBox Text="{Binding DescriptorInfo.ConfigurationDescriptor, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" BorderThickness="0" Background="Transparent" />
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="Interface">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBox Text="{Binding DescriptorInfo.InterfaceDescriptor, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" BorderThickness="0" Background="Transparent" />
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="Endpoint">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBox Text="{Binding DescriptorInfo.EndpointDescriptor, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" BorderThickness="0" Background="Transparent" />
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </GroupBox>

            <GroupBox Grid.Row="0" Grid.Column="1" Header="Input Report" Margin="12">
                <StackPanel Margin="12">
                    <TextBlock Text="最終受信時刻:" FontWeight="Bold" />
                    <TextBlock Text="{Binding LastInputReportTimestamp}" Margin="0,0,0,8" />
                    <TextBlock Text="ペイロード:" FontWeight="Bold" />
                    <TextBlock Text="{Binding LastInputReport}" TextWrapping="Wrap" />
                </StackPanel>
            </GroupBox>

            <GroupBox Grid.Row="0" Grid.Column="2" Header="Output Report" Margin="12">
                <StackPanel Margin="8">
                    <TextBlock Text="HEXデータを入力 (Report IDを先頭に記載)" />
                    <TextBox Text="{Binding OutputReportText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="80" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="送信長(バイト):" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox Text="{Binding OutputReportLengthText, UpdateSourceTrigger=PropertyChanged}" Width="100" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <TextBlock Text="{Binding OutputStatusMessage}" VerticalAlignment="Center" Margin="8,0,0,0" />
                        <Button Content="送信" Command="{Binding SendOutputCommand}" Padding="12 6" />
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <GroupBox Grid.Row="1" Grid.Column="2" Header="Feature Report" Margin="12">
                <StackPanel Margin="8">
                    <TextBlock Text="HEXデータを入力 (Report IDを先頭に記載)" />
                    <TextBox Text="{Binding FeatureReportText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="80" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="送信長(バイト):" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox Text="{Binding FeatureReportLengthText, UpdateSourceTrigger=PropertyChanged}" Width="100" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="8">
                        <TextBlock Text="{Binding FeatureStatusMessage}" VerticalAlignment="Center" Margin="8,0,0,0" />
                        <Button Content="取得" Command="{Binding GetFeatureCommand}" Padding="12 6" />
                        <Button Content="送信" Command="{Binding SetFeatureCommand}" Padding="12 6" />
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <GroupBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Header="通信ログ">
                <DockPanel>
                    <ListView ItemsSource="{Binding LogEntries}" Margin="0"
                              HorizontalContentAlignment="Stretch"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              VirtualizingStackPanel.IsVirtualizing="True"
                              VirtualizingStackPanel.VirtualizationMode="Recycling">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="時刻" Width="100" DisplayMemberBinding="{Binding Timestamp}" />
                                <GridViewColumn Header="方向" Width="100" DisplayMemberBinding="{Binding Direction}" />
                                <GridViewColumn Header="メッセージ" Width="220" DisplayMemberBinding="{Binding Message}" />
                                <GridViewColumn Header="ペイロード" Width="280" DisplayMemberBinding="{Binding Payload}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </GroupBox>
        </Grid>

        <StatusBar Grid.Row="2" Margin="0 12 0 0">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
